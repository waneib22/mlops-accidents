# Identifiants DagsHub — fichier local, ignoré par git (ne jamais le committer).
#
# train_model.py enregistre le modèle dans le Model Registry DagsHub via
# dagshub.init(), ce qui exige un jeton personnel.
#
# Jeton : https://dagshub.com/user/settings/tokens
# Colle-le ci-dessous, puis : make airflow-down && make airflow-up
DAGSHUB_USER_TOKEN=

# Optionnels — utilisés par l'API pour le tracking MLflow sur DagsHub.
# Le chargement du modèle fonctionne en anonyme, ils ne sont pas obligatoires.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
